use crate::ast::{func::*, aexp::*};

// lalrpop 里的约定
grammar;

// 约束 lexer 的行为
match {
  // 跳过空白符和注释
  r"\s*" => {},
  r"//[^\n\r]*[\n\r]*" => {},
  r"/\*([^*]|\*[^/])*\*/" => {},
  // 剩下的情况采用默认方式处理
  _
}

// 定义 CompUnit, 其返回值类型为 String
// parser 在解析完成后的行为是返回 FuncDef 的值
pub CompUnit: CompUnit = <func_def: FuncDef> => CompUnit { <> };

FuncDef: FuncDef = {
  <func_type: FuncType> <ident: Ident> "(" ")" <block: Block> => {
    FuncDef { <> }
  }
}

FuncType: FuncType = "int" => FuncType::Int;

Block: Block = "{" <stmt: Stmt> "}" => Block { <> };

Stmt: Stmt = "return" <aexp: AExp> ";" => Stmt { <> };

Number: i32 = <num: IntConst> => <>;

// 最低优先级在最外层, 每层只出现本层运算符
AExp: AExp =  OrExp;

// or and eq
OrExp: AExp = {
  <lhs: OrExp> "||" <rhs: AndExp> => AExp::ABinary(ABinaryOp::Or, Box::new(lhs), Box::new(rhs)),
  <exp: AndExp> => exp,
};


AndExp: AExp = {
  <lhs: AndExp> "&&" <rhs: EqExp> => AExp::ABinary(ABinaryOp::And, Box::new(lhs), Box::new(rhs)),
  <exp: EqExp> => exp,
};

EqExp: AExp = {
  <lhs: EqExp> "==" <rhs: RelExp> => AExp::ABinary(ABinaryOp::Eq, Box::new(lhs), Box::new(rhs)),
  <lhs: EqExp> "!=" <rhs: RelExp> => AExp::ABinary(ABinaryOp::Neq, Box::new(lhs), Box::new(rhs)),
  <exp: RelExp> => exp,
};

RelExp: AExp = {
  <lhs: RelExp> "<" <rhs: AddExp> => AExp::ABinary(ABinaryOp::Lt, Box::new(lhs), Box::new(rhs)),
  <lhs: RelExp> "<=" <rhs: AddExp> => AExp::ABinary(ABinaryOp::Le, Box::new(lhs), Box::new(rhs)),
  <lhs: RelExp> ">" <rhs: AddExp> => AExp::ABinary(ABinaryOp::Gt, Box::new(lhs), Box::new(rhs)),
  <lhs: RelExp> ">=" <rhs: AddExp> => AExp::ABinary(ABinaryOp::Ge, Box::new(lhs), Box::new(rhs)),
  <exp: AddExp> => exp,
};

// + - (左结合)
AddExp: AExp = {
  <lhs: AddExp> "+" <rhs: MulExp> => AExp::ABinary(ABinaryOp::Plus, Box::new(lhs), Box::new(rhs)),
  <lhs: AddExp> "-" <rhs:MulExp> => AExp::ABinary(ABinaryOp::Minus, Box::new(lhs), Box::new(rhs)),
  <exp: MulExp> => exp,
};

// * (左结合)
MulExp: AExp = {
  <lhs: MulExp> "*" <rhs: UnaryExp> => AExp::ABinary(ABinaryOp::Mul, Box::new(lhs), Box::new(rhs)),
  <lhs: MulExp> "/" <rhs: UnaryExp> => AExp::ABinary(ABinaryOp::Div, Box::new(lhs), Box::new(rhs)),
  <lhs: MulExp> "%" <rhs: UnaryExp> => AExp::ABinary(ABinaryOp::Mod, Box::new(lhs), Box::new(rhs)),
  <exp: UnaryExp> => exp,
};

// 一元 + - ! (右递归)
UnaryExp: AExp = {
  <op: UnaryOp> <exp: UnaryExp> => AExp::AUnAry(op, Box::new(exp)),
  <exp: PrimaryExp> => exp,
};

// 括号和基本量 —— 括号里重新回到最低优先级
PrimaryExp: AExp = {
  "(" <exp: AExp> ")" => exp,
  <num: IntConst> => AExp::ANum(num),
};

UnaryOp: UnAryOp = {
  "+" => UnAryOp::Plus,
  "-" => UnAryOp::Minus,
  "!" => UnAryOp::Not,
}


// 如果匹配到标识符, 就返回这个字符串
// 一对尖括号在此处指代的是正则表达式匹配到的字符串 (&str)
// 关于尖括号到底代表什么, 请 RTFM
Ident: String = r"[_a-zA-Z][_a-zA-Z0-9]*" => <>.to_string();

// 对整数字面量的处理方式: 把匹配到的字符串按对应进制转换成数字
IntConst: i32 = {
  r"[1-9][0-9]*" => i32::from_str_radix(<>, 10).unwrap(),
  r"0[0-7]*" => i32::from_str_radix(<>, 8).unwrap(),
  r"0[xX][0-9a-fA-F]+" => i32::from_str_radix(&<>[2..], 16).unwrap(),
}
